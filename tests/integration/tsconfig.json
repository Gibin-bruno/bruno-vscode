{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    // Integration tests run in VS Code's extension host under mocha (via @vscode/test-cli).
    "types": ["node", "mocha", "vscode"]
  },
  "include": [
    "**/*.ts"
  ]
}
